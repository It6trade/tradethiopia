NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Use your MongoDB Atlas SRV connection string:
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Optional workaround for environments where Node cannot resolve Atlas SRV DNS:
MONGO_ATLAS_SEED_LIST=
MONGO_ATLAS_REPLICA_SET=
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173

# Puncher attendance integration (server-to-server only):
PUNCHER_API_URL=https://puncher-api-ashy.vercel.app
PUNCHER_API_EMAIL=replace_with_puncher_hr_email
PUNCHER_API_PASSWORD=replace_with_puncher_hr_password
PUNCHER_REQUEST_TIMEOUT_MS=15000

# Required for file and document uploads:
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=replace_with_your_project_id
APPWRITE_API_KEY=replace_with_your_server_api_key
APPWRITE_BUCKET_ID=replace_with_your_bucket_id

# Optional email integration:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS integration:
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM=TradeEthiopia

# Optional seed accounts:
COO_USERNAME=
COO_EMAIL=
COO_PASSWORD=
TRADEXTV_USERNAME=
TRADEXTV_EMAIL=
TRADEXTV_PASSWORD=

# Optional test variables:
FINANCE_E2E_MONGO_URI=
MONGOMS_SYSTEM_BINARY=
