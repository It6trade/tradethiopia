# Non-secret DNS workaround for this Atlas cluster.
# Credentials continue to come from MONGO_URI in backend/.env.
MONGO_ATLAS_SEED_LIST=cluster0-shard-00-00.epkpn.mongodb.net:27017,cluster0-shard-00-01.epkpn.mongodb.net:27017,cluster0-shard-00-02.epkpn.mongodb.net:27017
MONGO_ATLAS_REPLICA_SET=atlas-34uzw3-shard-0
